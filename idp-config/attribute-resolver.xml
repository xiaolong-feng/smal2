    <!-- Keep this attribute internal only. The standard SAML email attribute is "mail" below. -->
    <AttributeDefinition xsi:type="Simple" id="email">
        <InputDataConnector ref="myLDAP" attributeNames="email"/>
    </AttributeDefinition>

