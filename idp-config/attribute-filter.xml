<?xml version="1.0" encoding="UTF-8"?>
<AttributeFilterPolicyGroup id="ShibbolethFilterPolicy"
        xmlns="urn:mace:shibboleth:2.0:afp"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:mace:shibboleth:2.0:afp http://shibboleth.net/schema/idp/shibboleth-afp.xsd">

    <!--
        Default policy for existing services.

        Important: SATOSA is excluded here. Otherwise SATOSA would receive both
        email and mail from this broad policy and then also receive mail from the
        SATOSA-specific policy below, producing duplicate mail values.
    -->
    <AttributeFilterPolicy id="idpcarsidefault">
        <PolicyRequirementRule xsi:type="NOT">
            <Rule xsi:type="Requester" value="https://202.122.38.207:8443/sp" />
        </PolicyRequirementRule>

        <AttributeRule attributeID="eduPersonScopedAffiliation" permitAny="true"/>
        <AttributeRule attributeID="eduPersonEntitlement" permitAny="true"/>
        <AttributeRule attributeID="eduPersonTargetedID" permitAny="true"/>
        <AttributeRule attributeID="samlPairwiseID" permitAny="true"/>
        <AttributeRule attributeID="email" permitAny="true"/>
        <AttributeRule attributeID="mail" permitAny="true"/>
        <AttributeRule attributeID="givenName" permitAny="true"/>
        <AttributeRule attributeID="surname" permitAny="true"/>
        <AttributeRule attributeID="sn" permitAny="true"/>
        <AttributeRule attributeID="eduPersonPrincipalName" permitAny="true"/>
        <AttributeRule attributeID="uid" permitAny="true"/>
    </AttributeFilterPolicy>

    <!--
        SATOSA proxy SP.

        Keep this intentionally small. In particular, do not release both
        "email" and "mail" to SATOSA, because both can encode to the same SAML
        mail OID and produce duplicate values downstream in Indico.
    -->
    <AttributeFilterPolicy id="SATOSAProxyPolicy">
        <PolicyRequirementRule xsi:type="Requester" value="https://202.122.38.207:8443/sp" />

        <AttributeRule attributeID="samlPairwiseID" permitAny="true"/>
        <AttributeRule attributeID="eduPersonTargetedID" permitAny="true"/>
        <AttributeRule attributeID="mail" permitAny="true"/>
        <AttributeRule attributeID="eduPersonPrincipalName" permitAny="true"/>
    </AttributeFilterPolicy>

    <AttributeFilterPolicy id="ihepdefault">
        <PolicyRequirementRule xsi:type="OR">
            <Rule xsi:type="Requester" value="https://indico3-ldap.ihep.ac.cn/shibboleth" />
            <Rule xsi:type="Requester" value="https://twikinew.ihep.ac.cn/shibboleth" />
        </PolicyRequirementRule>
        <AttributeRule attributeID="eduPersonTargetedID">
            <PermitValueRule xsi:type="NOT">
                <Rule xsi:type="Requester" value="https://indico3-ldap.ihep.ac.cn/shibboleth" />
            </PermitValueRule>
        </AttributeRule>
    </AttributeFilterPolicy>

